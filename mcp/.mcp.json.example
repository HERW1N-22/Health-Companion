{
  "_comment": "Copy the `mcpServers.healthcompanion` block into your Claude Code .mcp.json (project root) or Claude Desktop config. Use the built path (npm run build first), or swap command/args to the tsx dev form shown below. Env can be inlined here OR left to mcp/.env.",

  "mcpServers": {
    "healthcompanion": {
      "command": "node",
      "args": ["/ABSOLUTE/PATH/TO/Health Companion/mcp/dist/index.js"],
      "env": {
        "HEALTH_COMPANION_SUPABASE_URL": "https://YOUR-PROJECT.supabase.co",
        "HEALTH_COMPANION_SUPABASE_ANON_KEY": "eyJ...",
        "HEALTH_COMPANION_USER_EMAIL": "you@example.com",
        "HEALTH_COMPANION_USER_PASSWORD": "your-healthcompanion-password"
      }
    },

    "healthcompanion_dev_tsx": {
      "command": "npx",
      "args": ["tsx", "/ABSOLUTE/PATH/TO/Health Companion/mcp/src/index.ts"],
      "_note": "No build step. Reads env from mcp/.env automatically. Slower cold start."
    }
  }
}
